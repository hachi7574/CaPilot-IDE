{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CaPilot",
  "version": "0.1.0",
  "identifier": "com.capilot.ide",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CaPilot",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: asset: https://asset.localhost; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "CaPilot IDE — 本地 AI 编程工作区",
    "longDescription": "CaPilot IDE 是一个本地 AI 编程工作区，支持交互式终端 PTY、文件编辑与版本控制。\n\nCaPilot IDE is a local AI coding workspace featuring interactive PTY terminals, file editing, and version control.",
    "copyright": "© 2026 hachi7574",
    "publisher": "hachi7574",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libdbus-1-3"
        ]
      },
      "appimage": {}
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hachi7574/CaPilot-Ide/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3QzczNzRBMzAxRkVDM0IKUldRNzdCOHdTamZIRjlNd3g0cXVxdmJIWjQrNGpKb1dKb1BIdnNsbHUyTzB6WDlhc0tEdEFFcTgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
